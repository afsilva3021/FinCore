# Copie para .env e troque TODOS os valores marcados "trocar". Nunca faça commit do .env.

# --- Aplicação ---
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO
# Obrigatório trocar para rodar em container/produção (a aplicação recusa subir com este valor
# fora de 127.0.0.1). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=local-development-key-change-before-deploying
# true quando a aplicação estiver atrás de HTTPS (produção).
SECURE_COOKIES=false
# IPs do proxy reverso (ex.: 172.18.0.5), separados por vírgula. Vazio = sem proxy.
TRUSTED_PROXIES=

# --- Banco: usuário dono (só migrations) --- trocar
POSTGRES_USER=fincore
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=fincore
# Usados apenas quando a aplicação roda fora do Docker (uv run fincore) com compose.dev.yaml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- Banco: usuário restrito da aplicação no Docker (sem DDL) --- trocar (16+ caracteres)
APP_DB_USER=fincore_app
APP_DB_PASSWORD=change-me-app-locally
